{
  "name": "offline-rf-flight-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node scripts/serve.mjs",
    "terrain:install": "node scripts/install-terrain.mjs",
    "browser:install": "node scripts/playwright.mjs install chromium",
    "test:browser": "node scripts/playwright.mjs test",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && node scripts/terrain-python.mjs -m unittest discover -s tests/terrain -p test_*.py",
    "terrain:prepare": "node scripts/terrain-python.mjs tools/terrain/prepare.py",
    "terrain:tiles": "node scripts/terrain-python.mjs tools/terrain/tiles.py",
    "terrain:package": "node scripts/terrain-python.mjs tools/terrain/package.py",
    "terrain:acquire": "node scripts/terrain-python.mjs tools/terrain/acquire.py",
    "terrain:build": "node scripts/terrain-python.mjs tools/terrain/build_region.py",
    "check": "tsc --noEmit && pnpm lint && pnpm test && pnpm build && node scripts/validate-build.mjs"
  },
  "dependencies": {
    "proj4": "^2.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
